ANTHROPIC_API_KEY=your-key-here

# Chat model as "provider:model". Examples:
#   anthropic:claude-sonnet-5-5   Claude via the Anthropic API (default)
#   ollama:gpt-oss:20b            local model served by Ollama
#   lmstudio:qwen/qwen3-8b        local model served by LM Studio (use the model id LM Studio shows)
#   openai:<model>                any OpenAI-compatible server when CHAT_BASE_URL is set (vLLM, llama.cpp, ...)
CHAT_MODEL=anthropic:claude-sonnet-5-5

# Optional chat model settings, mostly for local models
# CHAT_BASE_URL=http://localhost:11434      # Ollama default; LM Studio default is http://localhost:1234/v1
# CHAT_API_KEY=                             # only if your local server requires a token
# CHAT_TEMPERATURE=0                        # low values make tool calls more reliable
# CHAT_CONTEXT_WINDOW=16384                 # Ollama only; its default can be as small as 4k
# CHAT_REASONING=false                      # Ollama only: true / false / low / medium / high

# Any "provider:model" accepted by init_embeddings (re-run ingest.py after changing it)
EMBEDDING_MODEL=huggingface:sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=ollama:nomic-embed-text

# Relative paths resolve against the project folder
DOCS_DIR=sample_docs
CHROMA_DIR=data/chroma
TICKETS_FILE=data/tickets.json

CHUNK_SIZE=800
CHUNK_OVERLAP=120
MIN_RELEVANCE=0.3

# Set to use a separately deployed RAG server instead of spawning one locally
# RAG_SERVER_URL=http://127.0.0.1:8000/mcp
